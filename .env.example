# Необязательные настройки локального запуска. Пустое поле использует значение
# по умолчанию из docker-compose.yml. Секреты заполняются только в локальном .env.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
BACKEND_PORT=
GRAFANA_PORT=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
DEMO_MODE=

# Заглушка agent получает эти переменные, но пока не использует их.
TELEGRAM_BOT_TOKEN=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDINGS_MODEL=

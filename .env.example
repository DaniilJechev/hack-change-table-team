# Скопируйте в .env. Пустые секреты допустимы только в демо.
DEMO_MODE=true
TELEGRAM_BOT_TOKEN=
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
# Движок агента: graph (LangGraph StateGraph) или legacy (прежний Router → Executor).
AGENT_ENGINE=graph
# agent — LLM отвечает сама, вызывая кейсы как инструменты; router — прежний путь Router → Executor.
# Без настоящей LLM (LLM_PROVIDER=fake, демо без LLM_IN_DEMO) всегда работает router.
AGENT_MODE=agent
# Демо на фикстурах, но Router, бриф и H3 — через настоящую LLM (нужны LLM_MODEL и LLM_API_KEY, тратит деньги).
LLM_IN_DEMO=false
# Контекстная память (только движок graph): последние MEMORY_MAX_TURNS ходов (ход = запрос + ответ),
# хранятся MEMORY_TTL_SECONDS секунд. В живом режиме — Redis из compose; в демо и без REDIS_URL — в памяти процесса.
MEMORY_ENABLED=true
MEMORY_MAX_TURNS=6
MEMORY_TTL_SECONDS=1800
REDIS_URL=
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
# Поиск по playbook (H3): bm25 — без модели и БД (по умолчанию, слабые машины, демо);
# vector — эмбеддинги e5 + pgvector; rrf — объединение обоих списков (Reciprocal Rank Fusion).
# Для vector/rrf: образ с AGENT_EXTRAS="--extra rag" и один раз `make ingest-compose`.
RAG_SEARCH_MODE=bm25
AGENT_EXTRAS=
# Пусто — PostgreSQL из Compose. Свой адрес: postgresql://user:password@host:5432/db
RAG_DATABASE_URL=
RAG_MIN_SIMILARITY=0.82
# Бриф (H0): время по умолчанию (если в календаре нет стендапа), часовой пояс и адрес редиректа
# /r/<item_id> для учёта переходов (пусто — прямые ссылки).
BRIEF_TIME=09:30
BRIEF_TIMEZONE=Europe/Moscow
REDIRECT_BASE_URL=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_VIEWER_PASSWORD=
BACKEND_PORT=8080
AGENT_PORT=8081
GRAFANA_PORT=3000
# Backend: локальный Compose имеет демонстрационный ключ; для работы задайте свой.
BUDDY_SERVICE_KEY=
# Настройки команды в БД имеют приоритет над этими значениями по умолчанию.
FEATURE_ACCESS_MONITORING=true
FEATURE_TEAM_ESCALATION=true
FEATURE_FAQ_PUBLICATION=true
GITHUB_PERSONAL_ACCESS_TOKEN=
# Живой GitHub только для указанной команды; demo использует прежние фикстуры.
GITHUB_REPOSITORY=DaniilJechev/hack-change-table-team
GITHUB_TEAM_ID=demo-orders
GITHUB_CATALOG_OBJECT_ID=demo-orders-github
# JSON: внутренний user_id -> настоящий GitHub login. Не Telegram username.
GITHUB_USER_LOGINS=
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
# JSON сервисного аккаунта Google целиком; календарь расшарить ему только на чтение.
GOOGLE_SERVICE_ACCOUNT_JSON=
# LangGraph Studio (make studio): трейсы в облако LangSmith — только по желанию, выключено по умолчанию.
# Состояния узлов и полный промпт видны в Studio и без этого (поля llm_calls и prompt).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-buddy
